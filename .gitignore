# Build output.
build/

# Rendered audio is never committed. It regenerates in seconds from the
# recipes that ARE in git, which is the whole point of shipping recipes --
# docs/SCOPE.md 11 applies the same rule to the engine's own renders.
*.wav

# Packaging output. All of it is assembled by scripts/package_*.sh from
# sources that ARE in git, so committing it would be committing a build.
dist-web/
dist-web.tar.gz
electron/payload/
electron/dist/
electron/node_modules/
mobile/www/
mobile/node_modules/
mobile/android/
mobile/ios/

# --- Shared by every repository of the workspace. These lines came from the
# workspace's .gitignore, which covered this folder until it became a
# repository of its own (2026-10-14).
build/
builds/
dist/
node_modules/
.cache/
*.o
*.a
*.dSYM/
.DS_Store
compile_commands.json
*~
# Development TLS material: the private key must never be committed.
certs/
*.pem
# Rendered audio is output, regenerated by running the renderer again; git
# history is permanent, so one accidental add would weigh the repository down.
*.wav
# CMake build folders
build-*/
