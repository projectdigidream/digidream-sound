{
  "name": "digidreamsound",
  "productName": "DigidreamSound",
  "version": "1.0.0",
  "description": "A sound-effect engine and its editor",
  "license": "MIT",
  "main": "main.js",
  "scripts": { "start": "electron ." },
  "build": {
    "appId": "com.digidreamsound.sfx",
    "productName": "DigidreamSound",
    "files": ["main.js", "preload.js", "payload/**/*"],
    "directories": { "output": "dist" },
    "mac": { "category": "public.app-category.music", "target": ["dmg", "zip"] },
    "win": { "target": ["nsis", "zip"] },
    "linux": { "target": ["AppImage", "tar.gz"], "category": "AudioVideo" },
    "fileAssociations": [
      { "ext": "sfxproj", "name": "DigidreamSound project", "role": "Editor" },
      { "ext": "sfxb", "name": "DigidreamSound bank", "role": "Viewer" }
    ]
  },
  "devDependencies": { "electron": "^31.0.0", "electron-builder": "^24.13.3" }
}
